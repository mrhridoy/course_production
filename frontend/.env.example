# ── Production values (baked into Docker image at build time) ─────────────────
NEXT_PUBLIC_API_URL=https://student.ictbangladesh.bd
NEXT_PUBLIC_API_BASE_PATH=/api/v1
NEXT_PUBLIC_SITE_URL=https://student.ictbangladesh.bd
NEXT_PUBLIC_SITE_NAME="ICT Bangladesh"

# Extra hosts allowed for next/image (comma-separated hostnames).
# The API host is allowed automatically. Add any host the API may return
# in absolute thumbnail URLs (e.g. an internal IP, a CDN, or S3).
NEXT_PUBLIC_IMAGE_HOSTS=65.118.64.4

# ── Local development override ─────────────────────────────────────────────────
# Copy the block below into a NEW file called .env.local (never commit it).
# This makes `npm run dev` call your local API instead of the live server,
# which prevents CORS errors.
#
# .env.local contents:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
