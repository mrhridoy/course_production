# Database — SQLite by default (development)
# To use Postgres, change to:
#   DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/ict_bangladesh
DATABASE_URL=sqlite:///./app.db

# JWT — must be 16+ characters; rotate before production.
SECRET_KEY=please-change-me-to-a-32-char-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=ICT Bangladesh API
APP_VERSION=1.0.0
DEBUG=True
BASE_URL=http://localhost:8000

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# SMTP credentials are NOT set here — admin configures them via
# PUT /api/v1/admin/settings/smtp from the dashboard.
